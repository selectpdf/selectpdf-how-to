<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- SelectPdf's Chromium engine for the machine that builds the app. Publishing with -r <rid> picks that
       platform instead (win-x64, win-x86, linux-x64, linux-arm64, osx-arm64). Reference one engine package
       per build: they unpack into the same folder. -->
  <PropertyGroup>
    <_SelectPdfArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</_SelectPdfArch>
    <SelectPdfRid Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-$(_SelectPdfArch)</SelectPdfRid>
    <SelectPdfRid Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux-$(_SelectPdfArch)</SelectPdfRid>
    <SelectPdfRid Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx-$(_SelectPdfArch)</SelectPdfRid>
    <SelectPdfRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</SelectPdfRid>
    <SelectPdfVersion>26.5.0</SelectPdfVersion>
  </PropertyGroup>

  <Target Name="_SelectPdfCheckPlatform" BeforeTargets="CollectPackageReferences;Build"
          Condition="'$(SelectPdfRid)' != 'win-x64' And '$(SelectPdfRid)' != 'win-x86' And '$(SelectPdfRid)' != 'linux-x64' And '$(SelectPdfRid)' != 'linux-arm64' And '$(SelectPdfRid)' != 'osx-arm64'">
    <Error Text="SelectPdf has no engine package for $(SelectPdfRid). Engine packages exist for win-x64, win-x86, linux-x64, linux-arm64 and osx-arm64." />
  </Target>

  <ItemGroup>
    <PackageReference Include="SelectPdf.Universal" Version="$(SelectPdfVersion)" />
    <PackageReference Include="SelectPdf.Universal.Native.$(SelectPdfRid)" Version="$(SelectPdfVersion)" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>

  <!-- the variations/ project runs the variation files -->
  <ItemGroup>
    <Compile Remove="variations/**" />
    <Content Remove="variations/**" />
    <None Remove="variations/**" />
  </ItemGroup>

</Project>

<template xmlns="http://www.xfa.org/schema/xfa-template/3.3/"><?formServer defaultPDFRenderFormat acrobat9.1dynamic?>
<subform name="form1" layout="tb" locale="en_US">
<pageSet><pageArea name="Page1"><contentArea x="0.5in" y="0.5in" w="7.5in" h="10in"/><medium stock="letter" short="8.5in" long="11in"/></pageArea></pageSet>
<subform name="Page1" w="7.5in" layout="tb">
<draw w="7.5in" h="0.5in"><ui><textEdit/></ui><value><text>Order form</text></value><font typeface="Arial" size="18pt" weight="bold"/></draw>
<field name="Name" w="4in" h="0.38in"><ui><textEdit><border><edge/></border><margin leftInset="1mm" rightInset="1mm"/></textEdit></ui><font typeface="Arial" size="10pt"/><para vAlign="middle"/>
<caption reserve="1.2in"><value><text>Name</text></value><para vAlign="middle"/></caption><assist><toolTip>Your full name</toolTip></assist>
<validate nullTest="error"/></field>
<field name="BirthDate" w="4in" h="0.38in"><ui><dateTimeEdit><border><edge/></border><margin leftInset="1mm" rightInset="1mm"/></dateTimeEdit></ui><font typeface="Arial" size="10pt"/><para vAlign="middle"/><value><date/></value>
<format><picture>date{MMMM D, YYYY}</picture></format>
<caption reserve="1.2in"><value><text>Date of birth</text></value><para vAlign="middle"/></caption></field>
<field name="Quantity" w="2.5in" h="0.38in"><ui><numericEdit><border><edge/></border><margin leftInset="1mm" rightInset="1mm"/></numericEdit></ui><font typeface="Arial" size="10pt"/><para vAlign="middle"/><value><integer/></value>
<caption reserve="1.2in"><value><text>Quantity</text></value><para vAlign="middle"/></caption>
<validate scriptTest="error"><script contentType="application/x-javascript">this.isNull || this.rawValue &gt; 0</script><message><text name="scriptTest">The quantity must be greater than zero.</text></message></validate></field>
<field name="Price" w="2.5in" h="0.38in"><ui><numericEdit><border><edge/></border><margin leftInset="1mm" rightInset="1mm"/></numericEdit></ui><font typeface="Arial" size="10pt"/><para vAlign="middle"/><value><decimal fracDigits="2"/></value>
<caption reserve="1.2in"><value><text>Unit price</text></value><para vAlign="middle"/></caption><format><picture>num{z,zz9.99}</picture></format></field>
<field name="Total" w="2.5in" h="0.38in" access="readOnly"><ui><numericEdit><border><edge/></border><margin leftInset="1mm" rightInset="1mm"/></numericEdit></ui><font typeface="Arial" size="10pt"/><para vAlign="middle"/><value><decimal fracDigits="2"/></value>
<caption reserve="1.2in"><value><text>Total</text></value><para vAlign="middle"/></caption><format><picture>num{z,zz9.99}</picture></format>
<calculate><script contentType="application/x-javascript">Quantity.rawValue * Price.rawValue</script></calculate></field>
<field name="Delivery" w="3in" h="0.38in"><ui><choiceList><border><edge/></border><margin leftInset="1mm" rightInset="1mm"/></choiceList></ui><font typeface="Arial" size="10pt"/><para vAlign="middle"/>
<caption reserve="1.2in"><value><text>Delivery</text></value><para vAlign="middle"/></caption>
<items><text>Standard</text><text>Express</text></items><items save="1" presence="hidden"><text>STD</text><text>EXP</text></items></field>
<field name="Agree" w="4in" h="0.3in"><ui><checkButton size="10pt"><border><edge/></border></checkButton></ui><font typeface="Arial" size="10pt"/><para vAlign="middle"/>
<items><integer>1</integer><integer>0</integer></items><caption placement="right" reserve="3.6in"><value><text>I accept the terms</text></value><para vAlign="middle"/></caption></field>
<field name="Check" w="1.5in" h="0.38in"><ui><button highlight="push"/></ui><border hand="right"><edge stroke="raised"/><fill><color value="212,208,200"/></fill></border><font typeface="Arial" size="10pt"/><para vAlign="middle"/><caption><value><text>Check</text></value><para hAlign="center" vAlign="middle"/></caption>
<event activity="click"><script contentType="application/x-javascript">
if (Name.isNull) xfa.host.messageBox("Please enter your name.");
else if (Agree.rawValue != 1) xfa.host.messageBox("Please accept the terms.");
else xfa.host.messageBox("The order of " + Name.rawValue + " is complete: " + Total.formattedValue + ".");
</script></event></field>
<field name="Signature" w="3in" h="0.8in"><ui><signature><border><edge/></border></signature></ui><font typeface="Arial" size="10pt"/><para vAlign="middle"/>
<caption placement="top" reserve="0.25in"><value><text>Signature</text></value><para vAlign="middle"/></caption></field>
</subform>
</subform>
</template>
endstream
endobj
